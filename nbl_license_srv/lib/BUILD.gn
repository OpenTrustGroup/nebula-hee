import("//build/sdk/sdk_atom.gni")

config("nbl_nmt_config") {
  include_dirs = [
    ".",
    "include",
  ]
}

static_library("libnbl_nmt_tee") {
  sources = [
      "nmt_tee_client.c",
  ]

  public_configs = [ ":nbl_nmt_config" ]
  configs -= [ "//build/config:symbol_visibility_hidden" ]

  deps = [
    "//third_party/hee-trusty/nbl_fwk",
    "//zircon/trusty/lib/lib/libc-trusty",
  ]
}

#################################################
## SDK
#################################################

sdk_atom("libnbl_nmt_tee_sdk") {
  domain = "cpp"
  name = "libnbl_nmt_tee"

  tags = [
    "type:compiled_shared",
    "arch:target"
  ]

  output_category = "hee/nbl_fwk_hee"

  files = []

  # copy all head files into sdk.
  all_files = exec_script("//build/sdk/list_files.sh", [rebase_path("include", root_build_dir)], "list lines")
  foreach(f, all_files) {
    files += [ {
      source = "include/$f"
      dest = "include/$f" } ]
  }

  # copy static libraries.
  files += [
    {
      source = "$target_out_dir/libnbl_nmt_tee.a"
      dest = "lib/libnbl_nmt_tee.a"
    }
  ]

  non_sdk_deps = [
    ":libnbl_nmt_tee",
  ]
}

#################################################
## SDK
#################################################

import("//build/nebula/nbl_sdk_library.gni")

nbl_sdk_library("nbl_nmt_tee_sdk") {
  name = "nbl_nmt_tee"
  category = "hee"

  hdr_dirs = [
    {
      source = "include/nbl_fwk"
      dest = "nbl_fwk"
    }
  ]

  libs = [
    "libnbl_nmt_tee.a",
  ]

  deps = [
    ":libnbl_nmt_tee",
  ]
}