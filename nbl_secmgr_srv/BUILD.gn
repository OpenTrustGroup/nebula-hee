import("//build/package.gni")

config("config") {
  include_dirs = [
    ".",
    "//zircon/trusty/lib/include/user",
    "common",
    "crypto",
    "util",
    "keystore",
    "otrp",
    "//third_party/hee-trusty",
    "//third_party/hee-trusty/nbl_nsc/lib/include"
  ]

  release_key_dir = getenv("SECMGR_RELEASE_KEY")
  if(release_key_dir != ""){
    print("secmgr def SECMGR_RELEASE_KEY")

    secmgr_hee_name_config = exec_script("//build/secmgr/read_secmgr_config.sh", [rebase_path("${release_key_dir}")], "list lines")
    if(secmgr_hee_name_config[0] != ""){#0 hee name
      print("secmgr hee name:${secmgr_hee_name_config[0]}")
      defines = [
        "GRT_LOG_LEVEL=4",
        "SECMGR_KEY_RELEASE",
        "HEE_NAME=\"${secmgr_hee_name_config[0]}\""
      ]
    }else{
      defines = [
        "GRT_LOG_LEVEL=4",
        "SECMGR_KEY_RELEASE"
      ]
    }
  }else{
    print("secmgr undef SECMGR_RELEASE_KEY")
    defines = [
      "GRT_LOG_LEVEL=4"
    ]
  }

  cflags = [
  ]
}

