library secmgr;

//uuid
struct UUID {
   uint32 time_low;
   uint16 time_mid;
   uint16 time_hi_and_version;
   array<uint8>:8 clock_seq_and_node;
};

[ServiceName="secmgr.TrustyAppLoader"]
interface TrustyAppLoader {
  1:Load(UUID uuid) -> (handle? vmo, uint64 size, int32 err, string manifest_json);
  2:FindAutoStartTAs() -> (vector<string>? tas);
};